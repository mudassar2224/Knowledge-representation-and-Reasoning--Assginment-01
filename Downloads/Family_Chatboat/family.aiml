<category>
  <pattern>HELLO</pattern>
  <template>
    <random>
      <li>Hello! Nice to meet you. Ask me anything about the family knowledge base.</li>
      <li>Hi there! I am ready for family questions about relations, dates, jobs, cities, and more.</li>
      <li>Hey! Good to see you. Try a question like "who is Ali's father?"</li>
      <li>Hello, nice to meet you. What would you like to know about the family?</li>
    </random>
  </template>
</category>

<category>
  <pattern>HI</pattern>
  <template><srai>HELLO</srai></template>
</category>

